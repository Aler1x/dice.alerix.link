---
import type schedule from '../data/schedule.json';
import FavIcon from './FavIcon.astro';

interface Props {
	e: (typeof schedule)[number];
	filter: string;
}
const { e, filter } = Astro.props;
---

<article class="ev" id={e.id} data-day={e.day} data-start={e.start} data-end={e.end} data-filter={filter}>
	<time>{e.start}<span>{e.end}</span></time>
	<div class="body">
		<h3>{e.title}</h3>
		{e.speaker && <p class="speaker">{e.speaker}</p>}
		<p class="meta">
			{[e.venue, e.place].filter(Boolean).join(' · ')}
			{e.note && <span class="note">{e.note}</span>}
		</p>
	</div>
	<button type="button" class="star" data-id={e.id} aria-pressed="false" aria-label="В обране"><FavIcon /></button>
</article>

<style>
	.ev {
		display: grid;
		grid-template-columns: 5.2rem 1fr auto;
		gap: 12px;
		align-items: start;
		margin-bottom: 12px;
		padding: 12px 12px 12px 14px;
		background: var(--wine);
		border: 2px solid color-mix(in srgb, var(--cream) 12%, transparent);
		border-radius: 14px;
	}
	time {
		display: grid;
		font: 700 1rem var(--display);
		color: var(--orange);
	}
	time span {
		font-size: 0.8rem;
		opacity: 0.8;
	}
	h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 800;
	}
	p {
		margin: 4px 0 0;
		font-size: 0.85rem;
	}
	.speaker {
		opacity: 0.85;
		font-style: italic;
	}
	.meta {
		color: var(--cyan);
		font-weight: 600;
	}
	.note {
		display: block;
		width: fit-content;
		margin-top: 4px;
		padding: 2px 8px;
		border-radius: 6px;
		background: color-mix(in srgb, var(--orange) 40%, transparent);
		color: var(--cream);
	}
	.star {
		width: 44px;
		height: 44px;
		margin: -4px;
		border: 0;
		border-radius: 50%;
		background: transparent;
		font-size: 1.4rem;
		line-height: 1;
		/* Opacity on the button, not an alpha color: fill and stroke overlap, and alpha shows the seam */
		color: var(--cream);
		opacity: 0.3;
		cursor: pointer;
		transition:
			transform 160ms var(--ease-out),
			color 150ms ease,
			opacity 150ms ease;
	}
	.star:active {
		transform: scale(0.85);
	}
	.star[aria-pressed='true'] {
		color: var(--yellow);
		opacity: 1;
	}
	@media (hover: hover) and (pointer: fine) {
		.star:not([aria-pressed='true']):hover {
			opacity: 0.6;
		}
	}

	.past {
		opacity: 0.45;
	}
	.now {
		border-color: var(--orange);
		box-shadow: 4px 4px 0 var(--orange);
	}
	.next {
		border-color: var(--yellow);
		box-shadow: 4px 4px 0 var(--yellow);
	}

	@media (max-width: 480px) {
		.ev {
			grid-template-columns: 4.2rem 1fr auto;
			gap: 8px;
		}
	}
</style>
