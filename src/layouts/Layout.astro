---
interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.jpg', Astro.site);
const imageAlt = 'Дракон ДайсКон і напис «Розклад Дайс Кон 2026», 2–4 жовтня, Львів';
---

<!doctype html>
<html lang="uk">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#5c1a3a" />
		<link rel="canonical" href={url} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="uk_UA" />
		<meta property="og:site_name" content="Дайс Кон" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<link rel="icon" type="image/png" sizes="64x64" href="/images/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Manrope:wght@400;600;800&display=swap&subset=cyrillic"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Runs before paint, so the saved favorite icon does not flash -->
		<script is:inline>
			try {
				if (localStorage.getItem('dicecon-icon') === 'dice') document.documentElement.classList.add('dice');
			} catch {}
		</script>
	</head>
	<body>
		<slot />
		<script>
			// iOS Safari applies :active only when a touch listener exists
			document.addEventListener('touchstart', () => {}, { passive: true });
			if (import.meta.env.PROD && 'serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker
						.register(`/sw.js?v=${APP_VERSION}`)
						.catch((error) => console.error('Service worker registration failed:', error));
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--wine: #5c1a3a;
		--wine-deep: #3f0f27;
		--cream: #fef0d1;
		--orange: #f26a3d;
		--yellow: #ffcd00;
		--cyan: #13bfe1;
		--display: 'Unbounded', system-ui, sans-serif;
		--ease-out: cubic-bezier(0.23, 1, 0.32, 1);
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--wine-deep);
		color: var(--cream);
		font: 16px/1.45 'Manrope', system-ui, sans-serif;
	}
	* {
		-webkit-tap-highlight-color: transparent;
	}
	/* Component display rules (grid, flex) must not override the hidden attribute */
	[hidden] {
		display: none !important;
	}
	button {
		font: inherit;
		color: inherit;
		transition: transform 160ms var(--ease-out);
	}
	/* Tap highlight is off, so the press scale is the only touch feedback */
	button:active {
		transform: scale(0.97);
	}
	button:focus-visible {
		outline: 2px solid var(--yellow);
		outline-offset: 2px;
	}
</style>
